---
import Icon from './Icon.astro';
import {dateTime, number, href, type Project, type Point} from '../lib/data';
interface Props { repo: Project; history: Point[]; archiveDate?: string }
const {repo, history, archiveDate} = Astro.props;
const values = history.map(p => p.stars);
const minimum = Math.min(...values), maximum = Math.max(...values);
const padding = Math.max((maximum - minimum) * 0.16, 1);
const low = Math.max(0, minimum - padding), high = maximum + padding;
const width = 760, height = 220, left = 65, right = 30, top = 25, bottom = 40;
const times = history.map(p => Date.parse(p.sampled_at));
const timeSpan = (times.at(-1) || 0) - (times[0] || 0);
const x = (i: number) => left + (width - left - right) * (timeSpan ? (times[i] - times[0]) / timeSpan : 0.5);
const y = (n: number) => height - bottom - (n - low) / (high - low || 1) * (height - top - bottom);
const segments: string[][] = [];
history.forEach((point, i) => {
  const hours = i ? (times[i] - times[i - 1]) / 3600000 : 0;
  if (!i || hours < 22 || hours > 26) segments.push([]);
  segments.at(-1)!.push(`${x(i)},${y(point.stars)}`);
});
---
<a class="back-link" href={archiveDate ? href(`history/${archiveDate}/`) : href()}><Icon name="back" size={17}/>{archiveDate ? '返回这一天的榜单' : '返回今日榜单'}</a>
{archiveDate && <div class="notice subtle">你正在查看 {archiveDate} 保存的项目介绍与数据。<a href={href(`projects/${repo.id}/`)}>查看最新记录</a></div>}
<article class="project-page">
  <header class="project-header"><div class="project-tags"><span>{repo.category}</span><span>{repo.kind}</span><span>{repo.license}</span></div><p class="project-owner">{repo.full_name.split('/')[0]} /</p><h1>{repo.name}</h1><p class="project-description">{repo.summary_zh || repo.description || '项目暂无公开描述，请查阅 README。'}</p>{!repo.summary_zh && <p class="content-pending">中文说明待补充 · 以下保留项目原始描述</p>}
    <div class="project-actions"><a class="primary-button" href={repo.homepage || repo.url} target="_blank" rel="noopener noreferrer">{repo.homepage ? '访问项目网站' : '前往 GitHub'}<Icon name="external" size={16}/></a>{repo.homepage && <a class="secondary-button" href={repo.url} target="_blank" rel="noopener noreferrer"><Icon name="github" size={17}/>GitHub 仓库</a>}<a class="text-button" href={repo.readme_url} target="_blank" rel="noopener noreferrer">阅读 README <Icon name="arrow" size={16}/></a></div>
  </header>
  <div class="project-grid"><div class="project-reading"><section class="article-section"><h2>适合谁，能做什么</h2><p>{repo.audience_zh || '适用人群尚待资料确认。建议先阅读项目文档，了解使用方式和运行要求。'}</p><div class="source-note"><Icon name="book" size={18}/><p>{repo.content_status === 'editorial' ? '中文介绍由编辑依据项目公开材料整理。' : repo.content_status === 'generated' ? '中文介绍由模型依据 README 和官方说明生成。' : '尚无通过校验的中文介绍，暂时保留原始描述。'}<a href={repo.readme_url} target="_blank" rel="noopener noreferrer">查阅原始材料 <Icon name="external" size={12}/></a></p></div></section>
  <section class="article-section"><div class="section-heading"><h2>已经记录的增长</h2><span class="muted">{history.length} 次有效采样</span></div>{history.length < 2 ? <div class="chart-warming"><Icon name="clock" size={28}/><h3>曲线从第二个真实记录开始</h3><p>目前记录了 {number(repo.stars)} 颗 Star。下一次有效采样后，才能比较变化。</p></div> : <div class="chart-wrap"><svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`${repo.name} 已记录的 Star 总数趋势，共 ${history.length} 次采样`}><title>Star 总数趋势，数据自跟踪之日起记录</title>{[0, 0.5, 1].map(t => {const n = low + (high - low) * t; return <g><line x1={left} x2={width - right} y1={y(n)} y2={y(n)} stroke="#e1e8e3"/><text x={left - 12} y={y(n) + 4} text-anchor="end" fill="#586963" font-size="11">{number(Math.round(n))}</text></g>;})}{segments.filter(segment => segment.length > 1).map(segment => <polyline points={segment.join(' ')} fill="none" stroke="#146c4e" stroke-width="2.5" stroke-linejoin="round"/>)}{history.map((p, i) => <circle cx={x(i)} cy={y(p.stars)} r="3.5" fill="#146c4e"><title>{p.date}：{number(p.stars)} Star</title></circle>)}<text x={left} y={height - 10} fill="#586963" font-size="11">{history[0]?.date}</text><text x={width - right} y={height - 10} text-anchor="end" fill="#586963" font-size="11">{history.at(-1)?.date}</text></svg></div>}
    <div class="history-table-wrap"><table class="history-table"><caption class="sr-only">{repo.name} 的真实采样记录</caption><thead><tr><th>采样日期</th><th>Star 总数</th><th>近一日净增</th></tr></thead><tbody>{[...history].reverse().slice(0, 30).map(point => <tr><td><time datetime={point.sampled_at}>{dateTime(point.sampled_at)}</time></td><td>{number(point.stars)}</td><td>{point.delta === null ? '—' : `${point.delta > 0 ? '+' : ''}${number(point.delta)}`}</td></tr>)}</tbody></table></div></section>
  {repo.evidence.length > 0 && <section class="article-section"><h2>介绍依据</h2><p class="muted">以下为支撑中文介绍的官方材料片段。</p>{repo.evidence.map(item => <blockquote><p>{item.quote}</p><a href={item.url} target="_blank" rel="noopener noreferrer">查看出处 <Icon name="external" size={12}/></a></blockquote>)}</section>}</div>
  <aside class="project-facts"><h2>项目记录</h2><dl><div><dt>总 Star</dt><dd>{number(repo.stars)}</dd></div><div><dt>近一日净增</dt><dd class={repo.delta !== null && repo.delta > 0 ? 'positive' : ''}>{repo.delta === null ? '数据积累中' : `${repo.delta > 0 ? '+' : ''}${number(repo.delta)}`}</dd></div><div><dt>主要语言</dt><dd>{repo.language || '未标注'}</dd></div><div><dt>许可证</dt><dd>{repo.license}</dd></div></dl><div class="facts-dates"><p>项目最近更新<span>{dateTime(repo.pushed_at)}</span></p><p>本次采样时间<span>{dateTime(repo.sampled_at)}</span></p>{repo.window_start && <p>本次对比区间<span>{dateTime(repo.window_start)} 至 {dateTime(repo.window_end)}<br/>{repo.window_hours?.toFixed(2)} 小时{repo.observation === 'invalid_window' ? ' · 未参与排名' : ''}</span></p>}</div><p class="facts-caution">记录从首次跟踪开始。缺失日期不补值，也不补画历史增长。</p></aside></div>
</article>
